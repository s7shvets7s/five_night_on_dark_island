{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"]
    }
  },
  "watcher": {
    "ignore": [
      "qwen-cli/**",
      ".qwen/**",
      ".venv/**"
    ]
  },
  "agent": {
    "default": {
      "prompt": "./prompts/yandex-fnaf.txt"
    }

  },
  
  
  
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"]
  
}